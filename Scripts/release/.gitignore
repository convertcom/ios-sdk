# Release tooling dependency tree — never committed. The pinned, reproducible
# tree lives in yarn.lock (committed); node_modules is the materialized
# install and stays local / CI-only. Keeps the isolated release manifest (AC5.3)
# out of the SDK's git footprint.
node_modules/

# Yarn's local install state / cache. The committed artifacts are yarn.lock and
# .yarnrc.yml; everything Yarn materializes under .yarn/ is machine-local.
.yarn/
.pnp.*
